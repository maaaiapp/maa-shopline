# Copy to .env for local dev only. Never commit real values. Production values live in
# Render (API), GitHub Actions secrets (DRAIN_URL/DRAIN_SECRET), Supabase Vault (drain_url/drain_secret).
APP_ENV=dev
SHOPLINE_SUPABASE_REF=            # 20 chars, copied from the live Supabase dashboard
SUPABASE_URL=                     # https://<ref>.supabase.co
DATABASE_URL=                     # transaction pooler URI (contains the ref)
SHOPLINE_APP_KEY=
SHOPLINE_APP_SECRET=
SHOPLINE_REDIRECT_URI=
SHOPLINE_SCOPES=
SHOPLINE_WEBHOOK_TS_HEADER=       # leave empty until SHOPLINE confirms the header name
TOKEN_ENCRYPTION_KEY=             # base64 of 32 random bytes
NVIDIA_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=               # free models only, PUBLIC data only
GEMINI_API_KEY=                   # Google AI Studio key
DRAIN_SECRET=                     # >=32 random chars; same value in Supabase Vault + GitHub secret
ADMIN_TOKEN=                      # >=32 random chars, different from DRAIN_SECRET
ALERT_WEBHOOK_URL=                # Slack or Discord incoming webhook
